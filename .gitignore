# .gitignore - Archivos a ignorar en Git

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Flask
instance/
.webassets-cache

# Base de datos (no incluir BD en repositorio)
*.db
*.sqlite
*.sqlite3

# Variables de entorno (NUNCA comprometer .env)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/

# Imágenes de prueba
static/img/productos/
!static/img/productos/.gitkeep

# Logs
*.log
logs/
*.log.*

# Otros
.cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Temporal
*.tmp
temp/
