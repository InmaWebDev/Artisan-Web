# Copiar este archivo a .env y rellenar los valores
# Copy this file to .env and fill in the values

# Clave secreta para sesiones (cambiar a algo seguro en producción)
SECRET_KEY=tu_clave_secreta_aqui_cambiar_en_produccion

# Teléfono de WhatsApp para recibir pedidos (formato internacional sin +)
WHATSAPP_PHONE=573123580705

# URL de la base de datos (PostgreSQL). Si no se provee, se usa SQLite local.
# Ejemplo: postgresql://usuario:password@localhost:5432/artisan_db
DATABASE_URL=postgresql://artisan_user:Passw0rd@localhost:5432/artisan_db

# DEBUG mode (solo en desarrollo / only for development)
FLASK_ENV=development
FLASK_DEBUG=0

# Opcional: configuración de rate limiting
RATELIMIT_STORAGE_URI=memory://

# Opcional: crear un administrador inicial al ejecutar `python database_setup.py`
# Añade estos valores solo para la inicialización; considera removerlos después.
INITIAL_ADMIN_EMAIL=admin@artisan.com
INITIAL_ADMIN_PASSWORD=TuPasswordAdminSegura123!
